// The harness gets its OWN project rather than being added to the root
// `include`, because it legitimately needs two compiler options `src` must not
// have:
//
//   allowImportingTsExtensions — main.tsx imports
//     `../src/renderer/src/pane/TerminalPane.tsx` WITH the extension on
//     purpose, to dodge vite.config.mts's anchored alias that rewrites the
//     extensionless specifier to StubTerminalPane (see main.tsx's own comment).
//     Loosening this for `src` would permit the same thing in app code, where
//     it is not wanted.
//   noUnusedLocals / noUnusedParameters — relaxed for the Old*.tsx snapshots,
//     which are verbatim `git show HEAD:` copies with their imports repointed
//     and nothing else changed. Editing them to satisfy a lint would defeat
//     the point of a snapshot.
//
// Added at #33 step 2b. Until then NO gate typechecked this directory, which
// is where every instrument defect this stage found actually lived.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts", "**/*.tsx", "../src"]
}
