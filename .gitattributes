# Every text file checks out with LF on every platform, whatever a machine's
# core.autocrlf says, so two maintainers on different OSes never see each
# other's checkouts as modified. The index already stores LF; the rules below
# override this one where a format needs other bytes.
* text=auto eol=lf

# Line endings for the file types the Windows port adds. cmd locates
# `call :label` targets by byte offset, so LF-only .cmd files are unreliable;
# PowerShell is conventionally CRLF on Windows. Existing repo files are
# deliberately NOT renormalized — these rules bind only new additions.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# CSP sha256 hashes are computed over exact bytes; a CRLF working-tree copy
# breaks the pre-paint theme guard on Windows checkouts.
*.html text eol=lf

# Embedded text must have the same bytes on every platform.
src-tauri/resources/third-party-licenses.json text eol=lf
scripts/gen-third-party-licenses.mjs text diff

*.bin binary
