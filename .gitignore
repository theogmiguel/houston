node_modules/
dist/
out/
target/
.env
.env.*
*.log
.houston/
# The pre-rename name. A daemon boot moves any leftover one to .houston/,
# but a checkout that has not booted one yet still has this on disk.
.tr/
.DS_Store
.playwright-mcp/
.research/
# Spec-driven working files (tlc-spec-lean); plan/checks/verification, never source.
.specs/
# Locally installed agent skills, never source.
.claude/*
!.claude/settings.json
.cursor/
.windsurf/
.agents/

# visual-harness photographs (ui/harness/shot.mjs) — artifacts, never source
ui/harness-shots/

# local CSS-conversion measuring harness, path-coupled to ui/ — never committed
ui/p5-harness/

# staged Tauri sidecars (<name>-<target triple>) — build output, never source
src-tauri/binaries/

# The Linux daemon staged for the Windows installer's WSL support
# (scripts/build-app.ps1 fills it) — build output, never source
src-tauri/wsl/

# The v2 server executable and its runtime node_modules staged as Tauri resources
# (scripts/stage-v2-server.mjs fills it) — build output, never source
src-tauri/v2-server/*
!src-tauri/v2-server/.gitkeep

# Local browser-inspection leftovers (Playwright CLI sessions and their screenshots)
.playwright-cli/
output/

# The orchestrator's working notes for an in-flight migration; never committed.
docs/implementation-notes.md

# Python bytecode is local build output.
__pycache__/
*.py[cod]

# Local memory-tool configuration.
.texas-ranger.toml

# Imported T3 Code tree (v2). node_modules/ and dist/ above already cover every
# workspace; these are the remaining build and tool outputs upstream ignores.
.bun/
.turbo/
*.tsbuildinfo
apps/*/node_modules/
apps/*/dist/
apps/*/dist-exe/
packages/*/node_modules/
packages/*/dist/
.vite-plus/
apps/*/.vite-plus/
packages/*/.vite-plus/
.t3/
.tanstack/
.vitest-*
__screenshots__/
apps/web/.playwright/
apps/web/playwright-report/
squashfs-root/
.vercel/
.gstack/
.plans/
audits/
.showcase/
.alchemy/
.pnpm-store/
.idea/

# vitest reporter output written beside the package under test
.vitest/
handoff/design/boards/.render.html
